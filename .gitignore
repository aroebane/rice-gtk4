# Whitelist. Every path is ignored unless re-included below.
*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/CREDITS.md
!/EGM.md
!/VERSION
!/.clang-format
!/.clang-tidy
!/.clangd
!/.editorconfig
!/.gitattributes
!/Makefile
!/meson.build
!/meson_options.txt

!/src/
!/src/**/
!/src/**/*.h
!/src/**/*.c
!/src/**/*.in
!/src/**/*.xml
!/src/**/*.py

!/data/
!/data/*.conf
!/data/*.ini
!/data/element-hooks.yaml
!/data/designs/
!/data/designs/*.ini

!/scripts/
!/scripts/release

!/tests/
!/tests/**
